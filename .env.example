APP_ENV=dev
PORT=8080
# Signs the session cookie
APP_SECRET=
# postgres://user:password@host:port/database (percent-encode special characters in the password)
DATABASE_URL=postgres://invoicing:invoicing@localhost:5432/invoicing
# Default invoice values, company and bank details, e-mail texts and templates (see default-settings.example.yml)
INVOICE_SETTINGS=storage/default-settings.yml
# The invoice templates (<template>.peb) and the images they embed
INVOICE_TEMPLATE_DIR=storage/templates
# The built client (npm run build)
WEB_ROOT=dist
# true: invoices are not e-mailed, and the MAILER_* variables are not needed
USE_MOCK_MAILER=true
MAILER_HOST=smtp.gmail.com
# 465 uses SSL, other ports STARTTLS
MAILER_PORT=465
MAILER_USER=
MAILER_PASSWORD=
